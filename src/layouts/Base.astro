---
import '../styles/global.css';
import { SITE } from '../lib/data';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonld?: object[];
  breadcrumbs?: { name: string; url: string }[];
}
const { title, description, canonical, jsonld = [], breadcrumbs = [] } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, SITE.url).href;

const org = {
  '@type': 'Organization',
  '@id': `${SITE.url}#organization`,
  name: SITE.name,
  url: SITE.url,
  legalName: SITE.publisher.legalName,
  email: SITE.publisher.email,
  sameAs: [SITE.publisher.linkedin],
};
const website = { '@type': 'WebSite', '@id': `${SITE.url}#website`, name: SITE.name, url: SITE.url, inLanguage: 'fr-FR', publisher: { '@id': `${SITE.url}#organization` } };
const crumbs = breadcrumbs.length
  ? [{ '@type': 'BreadcrumbList', itemListElement: [{ name: 'Accueil', url: SITE.url }, ...breadcrumbs].map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: b.url })) }]
  : [];
const graph = { '@context': 'https://schema.org', '@graph': [org, website, ...crumbs, ...jsonld] };
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.name} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — journal des mises à jour`} href="/journal/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="bg-paper text-ink antialiased">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:p-2 focus:bg-white">Aller au contenu</a>
    <header class="border-b border-line bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-4 py-3">
        <a href="/" aria-label="Guide RH - Accueil" class="block shrink-0"><img src="/guide-rh-logo.webp" alt="guide-rh.com" class="h-12 w-auto" /></a>
        <nav aria-label="Navigation principale" class="flex flex-wrap justify-end gap-x-4 gap-y-2 text-sm">
          <a href="/roleplay-ia" class="hover:underline">Roleplay IA</a>
          <a href="/glossaire" class="hover:underline">Glossaire</a>
          <a href="/methodologie" class="hover:underline">Méthodologie</a>
          <a href="/journal" class="hover:underline">Journal</a>
          <a href="/a-propos" class="hover:underline">À propos</a>
        </nav>
      </div>
    </header>
    {breadcrumbs.length > 0 && (
      <nav aria-label="Fil d'Ariane" class="mx-auto max-w-5xl px-4 pt-4 text-sm text-muted">
        <ol class="flex flex-wrap gap-1">
          <li><a href="/" class="hover:underline">Accueil</a> ›</li>
          {breadcrumbs.map((b, i) => (
            <li>{i < breadcrumbs.length - 1 ? <a href={b.url} class="hover:underline">{b.name}</a> : <span aria-current="page">{b.name}</span>}{i < breadcrumbs.length - 1 && ' ›'}</li>
          ))}
        </ol>
      </nav>
    )}
    <main id="contenu" class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
    <footer class="mt-16 border-t border-line bg-white text-sm text-muted">
      <div class="mx-auto max-w-5xl px-4 py-8">
        <p><strong class="text-ink">{SITE.name}</strong> — {SITE.tagline}.</p>
        <p class="mt-2">Édité par {SITE.publisher.legalName}. {SITE.funding}</p>
        <p class="mt-2">
          <a href="/methodologie" class="underline">Méthodologie</a> · <a href="/a-propos" class="underline">À propos et transparence</a> · <a href="/contact" class="underline">Contact et droit de réponse</a> · <a href="/mentions-legales" class="underline">Mentions légales</a> · <a href="/journal" class="underline">Journal des mises à jour</a>
        </p>
      </div>
    </footer>
  </body>
</html>
