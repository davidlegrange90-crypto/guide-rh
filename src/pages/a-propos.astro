---
import Base from '../layouts/Base.astro';
import Transparence from '../components/Transparence.astro';
import { SITE } from '../lib/data';
const url = `${SITE.url}/a-propos`;
const jsonld = SITE.authors.map((a) => ({ '@type': 'Person', name: a.name, jobTitle: a.role, sameAs: a.linkedin, worksFor: { '@id': `${SITE.url}#organization` } }));
---
<Base title="À propos de Guide RH : qui nous sommes, comment nous sommes financés" description="Guide RH est un guide éditorial expert consacré aux outils IA pour le développement des talents : éditeur, auteurs, financement, politique éditoriale et de correction." canonical={url} {jsonld} breadcrumbs={[{ name: 'À propos', url }]}>
  <h1>À propos</h1>
  <p class="mt-4 text-lg">Guide RH analyse et compare les outils d'intelligence artificielle utilisés pour développer les compétences en entreprise : roleplay IA aujourd'hui, coaching IA et autres catégories ensuite. Le site s'adresse aux DRH, responsables formation et managers qui doivent choisir un outil sans le tester eux-mêmes.</p>

  <h2>Qui édite le site</h2>
  <p>{SITE.publisher.legalName}, {SITE.publisher.address}. SIREN {SITE.publisher.siren}. SIRET {SITE.publisher.siret}. Contact : <a href={`mailto:${SITE.publisher.email}`}>{SITE.publisher.email}</a>. Suivre <a href={SITE.publisher.linkedin_company} rel="me noopener">Guide RH sur LinkedIn</a>.</p>

  <h2>Les auteurs</h2>
  <ul class="list">{SITE.authors.map((a) => (<li id={a.id}><a href={a.linkedin} rel="author me">{a.name}</a> — {a.role}</li>))}</ul>

  <h2>Politique éditoriale</h2>
  <ul class="list">
    <li>Nous distinguons l’analyse documentaire, les déclarations des éditeurs et les éventuels tests standardisés réalisés selon notre <a href="/methodologie">méthodologie</a>.</li>
    <li>Lorsqu’un lien professionnel ou commercial existe avec une solution présentée, il est indiqué explicitement sur sa fiche.</li>
    <li>Nous distinguons toujours ce que déclare un éditeur de ce que nous avons vérifié.</li>
    <li>Nous corrigeons les erreurs signalées et datons chaque correction dans le <a href="/journal">journal</a>.</li>
  </ul>

  <h2>Comment nous contactons les éditeurs</h2>
  <p>Les éditeurs peuvent signaler une erreur factuelle ou exercer un droit de réponse via la page contact. Les corrections sont datées et documentées dans le journal des mises à jour.</p>

  <Transparence />
</Base>
