---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORY, rankedProviders, formatDate } from '../lib/data';
const providers = rankedProviders();
const tested = providers.filter((p) => p.score !== null).length;
const entries = (await getCollection('journal')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 5);
---
<Base title="Guide RH : comparatifs indépendants des outils IA pour la formation et le développement des talents" description="Guide RH teste les outils d'IA utilisés en formation et développement des compétences : roleplay IA, coaching IA et plus. Méthode publique, auteurs nommés, notes issues de tests." canonical={SITE.url}>
  <h1>Les outils IA de développement des talents, testés et comparés</h1>
  <p class="mt-4 text-lg">{SITE.tagline}. Nous testons chaque solution sur les mêmes scénarios, en français, et publions la grille, les preuves et les droits de réponse.</p>

  <h2>Comparatifs</h2>
  <div class="mt-4 rounded border border-line bg-white p-4">
    <h3 class="mt-0"><a href="/roleplay-ia">Roleplay IA : jeu de rôle et simulation conversationnelle pour la formation</a></h3>
    <p>{providers.length} solutions au panel, {tested} testées et notées. Mis à jour le {formatDate(CATEGORY.updated)}.</p>
    <p class="text-sm">Par cas d'usage : <a href="/roleplay-ia/managers">managers</a>, <a href="/roleplay-ia/gestion-des-conflits">gestion des conflits</a>, <a href="/roleplay-ia/feedback">feedback</a>, <a href="/roleplay-ia/entretien-annuel">entretien annuel</a>, <a href="/roleplay-ia/equipes-commerciales">équipes commerciales</a>, <a href="/roleplay-ia/relation-client">relation client</a>, <a href="/roleplay-ia/onboarding">onboarding</a>, <a href="/roleplay-ia/recrutement">recrutement</a>.</p>
  </div>
  <p class="mt-4 text-sm text-muted">À venir : coaching IA, évaluation des compétences, LXP augmentées par l'IA, feedback et entretiens, onboarding.</p>

  <h2>Comment nous travaillons</h2>
  <ol class="list">
    <li>Même questionnaire et même accès d'essai pour tous les éditeurs.</li>
    <li>Mêmes scénarios de test, en français, joués par deux testeurs.</li>
    <li>Grille de 11 critères pondérés, publique : <a href="/methodologie">méthodologie</a>.</li>
    <li>Droit de réponse publié tel quel ; aucun éditeur ne valide les notes.</li>
  </ol>

  <h2>Dernières mises à jour</h2>
  <ul class="list">{entries.map((e) => (<li><time datetime={e.data.date.toISOString().slice(0,10)}>{formatDate(e.data.date.toISOString())}</time> — <a href="/journal">{e.data.title}</a></li>))}</ul>
</Base>
