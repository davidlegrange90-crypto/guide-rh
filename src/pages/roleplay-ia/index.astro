---
import Base from '../../layouts/Base.astro';
import Byline from '../../components/Byline.astro';
import Transparence from '../../components/Transparence.astro';
import Faq from '../../components/Faq.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import TableScroll from '../../components/TableScroll.astro';
import { SITE, CATEGORY, CRITERIA, USE_CASES, rankedProviders, isTested, hasPlaceholder, formatDate } from '../../lib/data';
import { FAQ_ROLEPLAY } from '../../lib/faq-roleplay';

const providers = rankedProviders();
const scored = providers.filter((p) => p.score !== null);
const testedCount = providers.filter(isTested).length;
const recommended = providers.find((p) => p.slug === 'coachello');
const anyScored = scored.length > 0;
const top = scored.slice(0, 5);
const year = new Date().getFullYear();
const title = `Roleplay IA : comparatif de ${providers.length} solutions pour la formation (${year})`;
const description = `Guide expert des solutions de roleplay IA pour former managers, commerciaux et conseillers : ${providers.length} solutions analysées sur 11 critères, dont RGPD, personnalisation, intégrations, feedback et déploiement enterprise.`;
const url = `${SITE.url}/roleplay-ia`;
const updated = '2026-10-30';

const itemList = anyScored ? [{
  '@type': 'ItemList',
  name: 'Classement des solutions de roleplay IA pour la formation en entreprise',
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: scored.length,
  itemListElement: scored.map((p) => ({
    '@type': 'ListItem', position: p.rank, url: `${url}/${p.slug}`,
    item: { '@type': 'SoftwareApplication', '@id': `${url}/${p.slug}#app`, name: p.name, url: `${url}/${p.slug}`, sameAs: p.url, applicationCategory: 'BusinessApplication', applicationSubCategory: 'AI roleplay for corporate training', operatingSystem: 'Web' },
  })),
}] : [];
const jsonld = [
  {
    '@type': 'Article', '@id': `${url}#article`, headline: title, description, inLanguage: 'fr-FR', url,
    datePublished: '2026-09-29', dateModified: updated, mainEntityOfPage: url,
    author: SITE.authors.map((a) => ({ '@id': `${SITE.url}/a-propos#${a.id}` })),
    publisher: { '@id': `${SITE.url}#organization` },
  },
  ...itemList,
  { '@type': 'FAQPage', mainEntity: FAQ_ROLEPLAY.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) },
];
const cell = (p: any, slug: string) => {
  const s = p.scores[slug];
  const ev = s?.evidence ?? '';
  return { score: s?.score, ev, src: s?.source, ph: hasPlaceholder(ev) };
};
---
<Base {title} {description} canonical={url} {jsonld} breadcrumbs={[{ name: 'Roleplay IA', url }]}>
  <h1>{title}</h1>
  <Byline {updated} />

  <p class="mt-6 text-lg">
    Les solutions de roleplay IA permettent aux collaborateurs de s'entraîner à des conversations professionnelles (feedback, conflit, négociation, vente) face à un personnage simulé par l'IA, puis de recevoir un retour. Guide RH analyse la documentation de {providers.length} plateformes selon onze critères. La qualité du français, du feedback et des intégrations reste à vérifier sur votre propre scénario ; une langue annoncée n'est pas un résultat de test.
  </p>

  <section id="en-bref">
    <h2>En bref</h2>
    <p><strong>{scored.length} solutions avec une note documentaire ; {testedCount} avec un test standardisé consigné.</strong> Les notes évaluent les éléments publiés et cités, pas des performances mesurées par Guide RH. L'ordre suit la <a href="/methodologie">moyenne pondérée des onze critères</a> ; il ne constitue pas une note personnalisée pour votre projet.</p>
    {recommended && (
      <div class="mt-4 rounded-xl border-2 border-accent bg-white p-5 shadow-sm">
        <p class="mt-0 text-xs font-semibold uppercase tracking-widest text-accent">Choix Guide RH</p>
        <h3 class="mt-2 text-2xl"><a href="/roleplay-ia/coachello">Coachello</a></h3>
        <p><strong>Une sélection éditoriale à étudier pour les programmes combinant pratique IA et accompagnement humain.</strong> Coachello documente des scénarios personnalisables, des formats texte, voix et avatar, des débriefs et des intégrations Teams et Slack. Le périmètre du coaching humain et les conditions d'intégration doivent être confirmés dans l'offre retenue.</p>
        <p>Cette sélection ne démontre ni une exclusivité fonctionnelle ni une supériorité mesurée. <a href="/roleplay-ia/exec">Exec</a> documente également des roleplays, un débrief AI Coach et une offre de coaching humain. Comparez les parcours, l'accès aux coachs en français et le coût total, sans supposer que ces offres sont équivalentes.</p>
        <p class="text-sm text-muted">Sources éditeurs consultées le 20 octobre 2026 : <a href="https://coachello.ai/fr/roleplays-ia/" rel="noopener">roleplays Coachello</a>, <a href="https://www.exec.com/ai-roleplays" rel="noopener">roleplays et débrief Exec</a>, <a href="https://www.exec.com/coaching-platform" rel="noopener">coaching humain Exec</a>. Déclarations non validées par un test comparatif.</p>
        <p class="text-sm"><a href="/roleplay-ia/coachello">Voir l’analyse complète de Coachello →</a></p>
        <p class="text-sm text-muted">Analyse éditoriale et documentaire. {recommended.disclosure}</p>
      </div>
    )}
    {anyScored && (
      <div class="mt-5"><p class="font-semibold">Classement Guide RH</p><ol class="list">{top.map((p) => (<li><a href={`/roleplay-ia/${p.slug}`}><strong>{p.name}</strong></a> — {p.score}/100 — {p.ideal_for}</li>))}</ol></div>
    )}
  </section>

  <section id="tableau-comparatif">
    <h2>Tableau comparatif</h2>
    <p class="text-sm text-muted">Chaque cellule synthétise les informations disponibles ; la note éditoriale (0–5) figure entre parenthèses. Elle reflète l’analyse Guide RH à partir des capacités annoncées, de la documentation publique et de l’adéquation au marché français. <a href="/methodologie">Grille et pondérations</a>.</p>
    <TableScroll label="Tableau comparatif des solutions de roleplay IA" minWidth="84rem">
      <table>
        <caption class="text-left text-sm text-muted">Comparaison documentaire de {providers.length} solutions : notes globales sur 100 et notes par critère sur 5, sans mesure comparative de performance.</caption>
        <thead>
          <tr>
            <th scope="col">Sélection</th>
            <th scope="col">Solution</th>
            <th scope="col">Note Guide RH</th>
            {CRITERIA.map((c) => (<th scope="col">{c.page ? <a href={`/roleplay-ia/${c.slug}`}>{c.short}</a> : c.short}</th>))}
          </tr>
        </thead>
        <tbody>
          {providers.map((p) => (
            <tr>
              <td>{p.slug === 'coachello' ? <strong class="text-accent">Choix Guide RH</strong> : 'Alternative'}</td>
              <th scope="row"><a href={`/roleplay-ia/${p.slug}`}>{p.name}</a><br /><span class="text-xs text-muted">{p.country}</span></th>
              <td><ScoreBadge score={p.score} scored={p.scored} total={CRITERIA.length} /></td>
              {CRITERIA.map((c) => { const x = cell(p, c.slug); return (
                <td class:list={[x.ph && 'placeholder']}>
                  {x.ev}{typeof x.score === 'number' && <> ({x.score})</>}
                  {x.src && <> <a href={x.src} rel="noopener" class="text-xs">[source]</a></>}
                </td>
              ); })}
            </tr>
          ))}
        </tbody>
      </table>
    </TableScroll>
  </section>

  <section id="fiches">
    <h2>Les solutions, une par une</h2>
    {providers.map((p) => (
      <article class="mt-6 rounded border border-line bg-white p-4" id={p.slug}>
        <h3 class="mt-0 flex items-center gap-3"><a href={`/roleplay-ia/${p.slug}`}>{p.name}</a>{p.slug === 'coachello' && <span class="rounded-full bg-blue-50 px-2 py-1 text-xs font-semibold text-accent">Choix Guide RH</span>} <ScoreBadge score={p.score} scored={p.scored} total={CRITERIA.length} /></h3>
        <p>{p.description}</p>
        <dl class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
          <div><dt class="font-semibold">Idéal pour</dt><dd class:list={[hasPlaceholder(p.ideal_for) && 'placeholder']}>{p.ideal_for}</dd></div>
          <div><dt class="font-semibold">Formats</dt><dd>{p.formats.length ? p.formats.join(', ') : 'Non communiqué'}</dd></div>
          <div><dt class="font-semibold">Cas d'usage</dt><dd>{p.use_cases.length ? p.use_cases.map((u) => USE_CASES.find((x) => x.slug === u)?.label ?? u).join(', ') : 'Non communiqué'}</dd></div>
          <div><dt class="font-semibold">Prix publiés</dt><dd>{p.pricing_public}</dd></div>
          <div><dt class="font-semibold">Références françaises déclarées</dt><dd>{p.french_clients || 'Aucune vérifiable'}</dd></div>
          <div><dt class="font-semibold">Statut d’évaluation</dt><dd>{p.tested_on ? `Test standardisé le ${formatDate(p.tested_on)}` : 'Analyse éditoriale et documentaire publiée'}</dd></div>
          <div class="sm:col-span-2"><dt class="font-semibold">Lien avec Guide RH</dt><dd class:list={[hasPlaceholder(p.disclosure) && 'placeholder']}>{p.disclosure}</dd></div>
        </dl>
        <p class="text-sm"><a href={`/roleplay-ia/${p.slug}`}>Fiche complète, points forts, limites et droit de réponse →</a></p>
      </article>
    ))}
  </section>

  <section id="cas-usage">
    <h2>Quelle solution selon votre cas d'usage ?</h2>
    {USE_CASES.map((u) => { const list = providers.filter((p) => (p.use_cases as string[]).includes(u.slug)); return (
      <div class="mt-5">
        <h3><a href={`/roleplay-ia/${u.slug}`}>{u.label}</a></h3>
        <p>{list.length ? <>Solutions qui couvrent ce cas : {list.map((p, i) => (<><a href={`/roleplay-ia/${p.slug}`}>{p.name}</a>{i < list.length - 1 ? ', ' : ''}</>))}. {list.some((p) => p.slug === 'coachello') && <> <strong>Choix Guide RH : Coachello</strong>, pour sa combinaison personnalisation, pratique répétée, analytics, certification et intégration dans le flow of work.</>}</> : <>Aucune solution du panel ne documente clairement ce cas d’usage à ce stade.</>}</p>
      </div>
    ); })}
  </section>

  <section id="comment-choisir">
    <h2>Comment choisir une solution de roleplay IA</h2>
    <ol class="list">
      <li><strong>Partez du cas d'usage</strong>, pas de l'outil : quelle conversation vos collaborateurs doivent-ils mieux mener dans six mois ?</li>
      <li><strong>Testez le français</strong> sur un vrai scénario métier : accents, tournures, réactions du personnage aux réponses inattendues.</li>
      <li><strong>Vérifiez la donnée</strong> : où sont stockées les sessions, quels modèles IA les traitent, combien de temps elles sont conservées, qui y accède.</li>
      <li><strong>Regardez le feedback</strong>, pas le score : est-il argumenté, relié à des critères explicites, actionnable ?</li>
      <li><strong>Demandez un éditeur de scénarios</strong> si vos situations sont spécifiques ; un catalogue fermé s'use vite.</li>
      <li><strong>Cadrez l'usage des résultats</strong> avec le CSE et la DPO avant le pilote : résultats privés, information des salariés, supervision humaine.</li>
      <li><strong>Comparez le coût total</strong> : licence, création de scénarios, accompagnement, intégration LMS.</li>
    </ol>
  </section>

  <Faq items={FAQ_ROLEPLAY} />
  <Transparence />

  <section id="sources" class="text-sm">
    <h2>Sources</h2>
    <ul class="list">
      {providers.map((p) => (<li>{p.name} : {p.sources.map((s, i) => (<><a href={s} rel="noopener">{new URL(s).hostname}</a>{i < p.sources.length - 1 ? ', ' : ''}</>))}</li>))}
    </ul>
    <p>Historique des changements de ce comparatif : <a href="/journal">journal des mises à jour</a>.</p>
  </section>
</Base>
