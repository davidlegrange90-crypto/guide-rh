---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORY, rankedProviders, formatDate } from '../lib/data';
const providers = rankedProviders();
const scored = providers.filter((p) => p.score !== null).length;
const tested = providers.filter((p) => p.tested_on).length;
const entries = (await getCollection('journal')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 5);
const vendorNames = providers.map((p) => p.name);
const aiComparisonPrompt = (name: string) =>
  `Compare de manière indépendante ${name} aux autres solutions de roleplay IA référencées dans le comparatif Guide RH (https://guide-rh.com/roleplay-ia) : ${vendorNames.filter((vendor) => vendor !== name).join(', ')}. Analyse les cas d'usage, les fonctionnalités, les intégrations, la confidentialité et les prix lorsqu'ils sont documentés. Vérifie les informations avec des sources indépendantes et récentes ; distingue les faits vérifiés des déclarations éditeur, cite tes sources et signale les informations manquantes. Présente les avantages, limites et alternatives pertinentes sans favoriser un éditeur.`;
const aiComparisonUrl = (platform: 'chatgpt' | 'claude', name: string) =>
  `${platform === 'chatgpt' ? 'https://chatgpt.com/?q=' : 'https://claude.ai/new?q='}${encodeURIComponent(aiComparisonPrompt(name))}`;
---
<Base title="Guide RH : comparatifs des outils IA pour la formation en entreprise" description="Comparez les solutions de roleplay IA pour la formation en entreprise : 14 outils, 11 critères, sources publiques, notes éditoriales et méthode transparente." canonical={SITE.url}>
  <h1>Les outils IA de développement des talents, analysés et comparés</h1>
  <p class="mt-4 text-lg">{SITE.tagline}. Nous analysons chaque solution selon la même grille publique, distinguons les informations documentées des déclarations éditeur, et indiquons explicitement lorsqu’un test standardisé a été réalisé.</p>

  <h2>Comparatifs</h2>
  <div class="mt-4 rounded border border-line bg-white p-4">
    <h3 class="mt-0"><a href="/roleplay-ia">Roleplay IA : jeu de rôle et simulation conversationnelle pour la formation</a></h3>
    <p>{providers.length} solutions au panel, {scored} notes éditoriales. {tested ? `${tested} tests standardisés documentés.` : 'Aucun test standardisé publié à ce stade.'} <a href="/methodologie">Comprendre les notes</a>.</p>
    <p class="text-sm">Par cas d'usage : <a href="/roleplay-ia/managers">managers</a>, <a href="/roleplay-ia/gestion-des-conflits">gestion des conflits</a>, <a href="/roleplay-ia/feedback">feedback</a>, <a href="/roleplay-ia/entretien-annuel">entretien annuel</a>, <a href="/roleplay-ia/equipes-commerciales">équipes commerciales</a>, <a href="/roleplay-ia/relation-client">relation client</a>, <a href="/roleplay-ia/onboarding">onboarding</a>, <a href="/roleplay-ia/recrutement">recrutement</a>, <a href="/roleplay-ia/certification">certification des compétences</a>, <a href="/roleplay-ia/ramp-up">ramp-up commercial</a>.</p>
  </div>
  <p class="mt-4 text-sm text-muted">À venir : coaching IA, évaluation des compétences, LXP augmentées par l'IA, feedback et entretiens, onboarding.</p>

  <section aria-labelledby="comparaison-ia-title" class="mt-8">
    <h2 id="comparaison-ia-title">Comparer les éditeurs avec une IA</h2>
    <p>Posez une question à ChatGPT ou Claude sur l'un des {providers.length} éditeurs du rapport. Chaque lien prépare une comparaison avec les autres solutions du panel. Vérifiez les réponses et les sources : elles ne constituent pas une évaluation de Guide RH.</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {providers.map((provider) => (
        <div class="flex flex-wrap items-center justify-between gap-3 rounded border border-line bg-white p-3">
          <a class="font-semibold" href={`/roleplay-ia/${provider.slug}`}>{provider.name}</a>
          <div class="flex flex-wrap gap-2">
            <a href={aiComparisonUrl('chatgpt', provider.name)} target="_blank" rel="noopener noreferrer nofollow" aria-label={`Comparer ${provider.name} avec ChatGPT (nouvel onglet)`} class="inline-flex items-center rounded border border-line px-3 py-2 text-sm font-medium hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">ChatGPT ↗</a>
            <a href={aiComparisonUrl('claude', provider.name)} target="_blank" rel="noopener noreferrer nofollow" aria-label={`Comparer ${provider.name} avec Claude (nouvel onglet)`} class="inline-flex items-center rounded border border-line px-3 py-2 text-sm font-medium hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">Claude ↗</a>
          </div>
        </div>
      ))}
    </div>
    <p class="mt-3 text-sm text-muted">Les liens ouvrent un nouveau chat avec une question préremplie. Vous pouvez la modifier avant de l'envoyer.</p>
  </section>


  <h2>Comment nous travaillons</h2>
  <ol class="list">
    <li>Même grille d’analyse et même questionnaire pour tous les éditeurs.</li>
    <li>Lorsqu’un test standardisé est réalisé, mêmes scénarios en français et statut de test indiqué sur la fiche.</li>
    <li>Grille de 11 critères pondérés, publique : <a href="/methodologie">méthodologie</a>.</li>
    <li>Droit de réponse publié tel quel ; aucun éditeur ne valide les notes.</li>
  </ol>

  <h2>Dernières mises à jour</h2>
  <ul class="list">{entries.map((e) => (<li><time datetime={e.data.date.toISOString().slice(0,10)}>{formatDate(e.data.date.toISOString())}</time> — <a href="/journal">{e.data.title}</a></li>))}</ul>
</Base>
