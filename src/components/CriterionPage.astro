---
import Base from '../layouts/Base.astro';
import Byline from './Byline.astro';
import Transparence from './Transparence.astro';
import TableScroll from './TableScroll.astro';
import { SITE, CATEGORY, CRITERION_TEMPLATE_UPDATED, CRITERIA, rankedProviders, hasPlaceholder, sourceHost } from '../lib/data';
import type { CriterionPage } from '../lib/content-roleplay';
import { formatEditorialHtml } from '../lib/editorial-html';

interface Props { c: CriterionPage }
const { c } = Astro.props;
const crit = CRITERIA.find((x) => x.slug === c.slug)!;
const list = rankedProviders();
const url = `${SITE.url}/roleplay-ia/${c.slug}`;
const updated = [c.updated ?? CATEGORY.updated, CRITERION_TEMPLATE_UPDATED].sort().at(-1)!;
const anyScored = list.some((p) => typeof (p.scores as any)[c.slug]?.score === 'number');
const jsonld = [
  { '@type': 'Article', '@id': `${url}#article`, headline: c.title, description: c.description, url, inLanguage: 'fr-FR', datePublished: '2026-09-29', dateModified: updated,
    author: SITE.authors.map((a) => ({ '@id': `${SITE.url}/a-propos#${a.id}` })), publisher: { '@id': `${SITE.url}#organization` } },
  { '@type': 'ItemList', '@id': `${url}#solutions`, name: `Comparaison des solutions sur le critère ${crit.label}`, numberOfItems: list.length,
    itemListElement: list.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/roleplay-ia/${p.slug}`, item: { '@id': `${SITE.url}/roleplay-ia/${p.slug}#app`, '@type': 'SoftwareApplication', name: p.name } })) },
];
---
<Base title={c.title} description={c.description} canonical={url} {jsonld} breadcrumbs={[{ name: 'Roleplay IA', url: `${SITE.url}/roleplay-ia` }, { name: crit.label, url }]}>
  <h1>{c.title}</h1>
  <Byline {updated} />
  <p class="mt-6 text-lg" set:html={formatEditorialHtml(c.answer)} />

  <section>
    <h2>Comment nous notons ce critère</h2>
    <p>{crit.description} Poids dans la note globale : <strong>{crit.weight}</strong> sur 100. <a href="/methodologie">Voir toute la grille</a>.</p>
  </section>

  <section>
    <h2>Solution par solution</h2>
    <TableScroll label={`Comparaison des solutions pour le critère ${crit.label}`} minWidth="58rem">
      <table>
      <thead><tr><th scope="col">Solution</th><th scope="col">Note Guide RH /5</th><th scope="col">Éléments pris en compte</th><th scope="col">Source</th></tr></thead>
      <tbody>{list.map((p) => { const s = (p.scores as any)[c.slug]; const host = s?.source ? sourceHost(s.source) : null; return (
        <tr><th scope="row"><a href={`/roleplay-ia/${p.slug}`}>{p.name}</a></th><td>{typeof s?.score === 'number' ? s.score : '—'}</td><td class:list={[hasPlaceholder(s?.evidence) && 'placeholder']}>{s?.evidence}</td><td>{s?.source ? <a href={s.source} rel="noopener" aria-label={`${host} — source pour ${p.name}, critère ${crit.label}`}>{host}</a> : '—'}</td></tr>
      ); })}</tbody>
      </table>
    </TableScroll>
  </section>

  {c.sections.map((s) => (<section><h2>{s.h}</h2><div class="prose-fr" set:html={formatEditorialHtml(s.body)} /></section>))}
  <Transparence />
</Base>
