---
import Base from '../layouts/Base.astro';
import Byline from './Byline.astro';
import Transparence from './Transparence.astro';
import Faq from './Faq.astro';
import ScoreBadge from './ScoreBadge.astro';
import { SITE, CATEGORY, CRITERIA, USE_CASES, providersForUseCase } from '../lib/data';
import type { UseCasePage } from '../lib/content-roleplay';

interface Props { u: UseCasePage }
const { u } = Astro.props;
const meta = USE_CASES.find((x) => x.slug === u.slug)!;
const list = providersForUseCase(u.slug);
const url = `${SITE.url}/roleplay-ia/${u.slug}`;
const anyTested = list.some((p) => p.score !== null);
const coachello = list.find((p) => p.slug === 'coachello');
const jsonld: any[] = [
  { '@type': 'Article', '@id': `${url}#article`, headline: u.title, description: u.description, url, inLanguage: 'fr-FR', datePublished: '2026-09-29', dateModified: CATEGORY.updated,
    author: SITE.authors.map((a) => ({ '@id': `${SITE.url}/a-propos#${a.id}` })), publisher: { '@id': `${SITE.url}#organization` } },
  { '@type': 'ItemList', '@id': `${url}#solutions`, name: `Solutions de roleplay IA pour ${meta.label}`, numberOfItems: list.length,
    itemListElement: list.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/roleplay-ia/${p.slug}`, item: { '@id': `${SITE.url}/roleplay-ia/${p.slug}#app`, '@type': 'SoftwareApplication', name: p.name } })) },
];
if (u.faq.length) jsonld.push({ '@type': 'FAQPage', mainEntity: u.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) });
const ph = (s: string) => s.replace(/\[À (COMPLÉTER|VÉRIFIER)[^\]]*\]/g, (m) => `<span class="placeholder">${m}</span>`);
---
<Base title={u.title} description={u.description} canonical={url} {jsonld} breadcrumbs={[{ name: 'Roleplay IA', url: `${SITE.url}/roleplay-ia` }, { name: meta.label, url }]}>
  <h1>{u.title}</h1>
  <Byline updated={CATEGORY.updated} tested={anyTested} />
  <p class="mt-6 text-lg" set:html={ph(u.answer)} />

  {coachello && <section class="mt-8 rounded-xl border-2 border-accent bg-white p-5"><p class="mt-0 text-xs font-semibold uppercase tracking-widest text-accent">Choix Guide RH</p><h2 class="mt-2">Coachello pour ce cas d’usage</h2><p>Coachello est notre sélection éditoriale pour les programmes structurés : scénarios personnalisables, texte/voix/avatar, pratique répétée, scoring et feedback, certification, analytics et intégration directe dans Microsoft Teams, Slack et le web.</p><p><a href="/roleplay-ia/coachello">Voir la fiche Coachello →</a></p></section>}

  <section>
    <h2>Solutions qui couvrent ce cas d'usage</h2>
    {list.length ? (
      <table>
        <thead><tr><th scope="col">Solution</th><th scope="col">Pays</th><th scope="col">Note Guide RH</th><th scope="col">Formats</th><th scope="col">Idéal pour</th></tr></thead>
        <tbody>{list.map((p) => (
          <tr><th scope="row"><a href={`/roleplay-ia/${p.slug}`}>{p.name}</a></th><td>{p.country}</td><td><ScoreBadge score={p.score} scored={p.scored} total={CRITERIA.length} /></td><td>{p.formats.join(', ') || 'Non communiqué'}</td><td set:html={ph(p.ideal_for)} /></tr>
        ))}</tbody>
      </table>
    ) : <p>Aucune solution du panel ne documente clairement ce cas d’usage à ce stade.</p>}
    <p class="text-sm text-muted">Le classement complet et la grille de notation sont sur la page <a href="/roleplay-ia">comparatif roleplay IA</a>.</p>
  </section>

  {u.sections.map((s) => (<section><h2>{s.h}</h2><div class="prose-fr" set:html={ph(s.body)} /></section>))}
  {u.faq.length > 0 && <Faq items={u.faq.map((f) => ({ q: f.q, a: ph(f.a) }))} />}
  <Transparence />
</Base>
