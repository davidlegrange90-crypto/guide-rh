---
import { SITE, formatDate } from '../lib/data';
interface Props { updated: string; tested?: boolean }
const { updated, tested = false } = Astro.props;
---
<p class="mt-2 text-sm text-muted">
  Par {SITE.authors.map((a, i) => (<><a href={`/a-propos#${a.id}`} rel="author">{a.name}</a>{i < SITE.authors.length - 1 ? ', ' : ''}</>))} ·
  Mis à jour le <time datetime={updated}>{formatDate(updated)}</time> ·
  <a href="/methodologie">Méthodologie</a> · <a href="/a-propos#transparence">Transparence</a>
  <span class="ml-2 text-muted">{tested ? 'Test standardisé documenté sur la fiche.' : 'Analyse éditoriale et documentaire. Les notes Guide RH ne sont pas des avis clients.'}</span>
</p>
