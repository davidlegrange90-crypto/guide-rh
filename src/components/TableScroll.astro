---
interface Props {
  label: string;
  minWidth?: string;
}

const { label, minWidth = '48rem' } = Astro.props;
---
<p class="table-scroll-hint text-sm text-muted">Sur petit écran, faites défiler le tableau horizontalement. Le cadre peut aussi recevoir le focus au clavier.</p>
<div
  class="table-scroll"
  role="region"
  aria-label={label}
  tabindex="0"
  style={`--table-min-width: ${minWidth}`}
>
  <slot />
</div>
