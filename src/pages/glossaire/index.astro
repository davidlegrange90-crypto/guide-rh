---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/data';
import { GLOSSAIRE } from '../../lib/glossaire';
const url = `${SITE.url}/glossaire`;
const jsonld = [{ '@type': 'DefinedTermSet', name: 'Glossaire des outils IA pour le développement des talents', url,
  hasDefinedTerm: GLOSSAIRE.map((g) => ({ '@type': 'DefinedTerm', name: g.term, description: g.def, url: `${url}/${g.slug}` })) }];
---
<Base title="Glossaire : roleplay IA, simulation, SCORM, Qualiopi, AI Act…" description="Définitions courtes des termes utilisés dans les comparatifs Guide RH : roleplay IA, mise en situation, coaching IA, xAPI, Qualiopi, OPCO, AI Act, RGPD." canonical={url} {jsonld} breadcrumbs={[{ name: 'Glossaire', url }]}>
  <h1>Glossaire</h1>
  <p class="mt-4 text-lg">Les termes utilisés dans nos comparatifs, définis en deux phrases, avec un renvoi vers la page où ils comptent.</p>
  <dl class="mt-6">
    {GLOSSAIRE.map((g) => (<div class="mt-4"><dt class="font-semibold"><a href={`/glossaire/${g.slug}`}>{g.term}</a></dt><dd>{g.def}</dd></div>))}
  </dl>
</Base>
